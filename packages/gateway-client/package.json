{
  "name": "@adaptive-agent/gateway-client",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist"],
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target bun --packages external && bunx tsc -p tsconfig.build.json --outDir dist",
    "typecheck": "bunx tsc --noEmit",
    "test": "bunx vitest run"
  },
  "dependencies": {
    "@adaptive-agent/core": "workspace:*",
    "@adaptive-agent/gateway-protocol": "workspace:*"
  },
  "devDependencies": { "bun-types": "^1.3.5", "typescript": "^5.8.3", "vitest": "^3.1.1" }
}
