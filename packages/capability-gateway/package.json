{
  "name": "@adaptive-agent/capability-gateway",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "scripts": {
    "build": "bun build src/index.ts src/main.ts --outdir dist --target bun --packages external && bunx tsc -p tsconfig.build.json --outDir dist",
    "start": "bun run src/main.ts",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@adaptive-agent/core": "workspace:*",
    "@adaptive-agent/gateway-protocol": "workspace:*",
    "jose": "^6.2.3",
    "pg": "^8.20.0"
  },
  "devDependencies": { "@types/pg": "^8.20.0", "bun-types": "^1.3.5", "typescript": "^5.8.3" }
}
