      "provider": "parallel",
      "apiKeyEnv": "PARALLEL_API_KEY",
      "maxConcurrency": 4,
      "accountQuota": 60,
      "accountQuotaWindowMs": 60000,
      "timeoutMs": 60000,
      "maxOutputBytes": 262144,
      "estimatedCostPerRequestUSD": 0.01
    }
  ]
}
