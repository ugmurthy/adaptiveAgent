{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AdaptiveAgent",
  "version": "0.1.0",
  "identifier": "com.adaptiveagent.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "bun run web:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AdaptiveAgent",
        "width": 940,
        "height": 760,
        "minWidth": 680,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; frame-src 'self'; img-src 'self' asset: http://asset.localhost data:; media-src 'self' data: blob:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/agent-runtime", "binaries/trace-session-sidecar"]
  }
}
