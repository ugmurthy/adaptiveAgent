{
  "name": "@adaptive-agent/desktop-app",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "bun test ./src/activity.bun.ts ./src/result-renderer.bun.ts ./src/workbench-state.bun.ts ./src/workbench-ux.bun.ts",
    "web:build": "vite build",
    "sidecar:prepare": "bun run scripts/prepare-sidecar.ts",
    "tauri:dev": "bun run sidecar:prepare && tauri dev",
    "tauri:build": "bun run sidecar:prepare && tauri build",
    "typecheck": "bunx svelte-check --tsconfig ./tsconfig.json && bunx tsc --noEmit"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "dompurify": "^3.2.6",
    "marked": "^15.0.12",
    "mermaid": "^11.4.1",
    "svelte": "^5.35.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.1.0",
    "@tauri-apps/cli": "^2.8.0",
    "@tsconfig/svelte": "^5.0.4",
    "@types/jsdom": "^21.1.7",
    "bun-types": "^1.3.5",
    "jsdom": "^26.1.0",
    "svelte-check": "^4.2.2",
    "typescript": "^5.8.3",
    "vite": "^7.0.2"
  }
}
